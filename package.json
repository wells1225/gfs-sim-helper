{
  "name": "sims-helper",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop helper for diagnosing Sims 4 crashes and managing mods",
  "author": "Tyler",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "fixtures": "node scripts/fixtures/make-fixture.ts",
    "locate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/locate/cli.ts",
    "inventory": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/inventory/cli.ts",
    "logs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/logs/cli.ts",
    "findings": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/main/rules/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:electron-node": "node scripts/electron-node/run.ts",
    "test:e2e": "playwright test",
    "test:screens": "playwright test --project=screens",
    "test:live": "playwright test --project=live",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.79.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
